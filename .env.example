# copy to .env and edit.  Provider: auto | anthropic | deepseek | gemini
LEXRAG_LLM_PROVIDER=auto

# --- DeepSeek (paid, cheap) ---
DEEPSEEK_API_KEY=
LEXRAG_DEEPSEEK_MODEL=deepseek-flash
LEXRAG_DEEPSEEK_ANSWER_EFFORT=none    # none (fastest) | low | high | max

# --- Google Gemini (free tier works) ---
GEMINI_API_KEY=
LEXRAG_GEMINI_MODEL=gemini-3.5-flash
LEXRAG_GEMINI_REWRITE_MODEL=gemini-3.5-flash-lite
LEXRAG_GEMINI_RPM=10

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
LEXRAG_LLM_MODEL=claude-opus-5-5
LEXRAG_REWRITE_MODEL=claude-opus-5-5

# --- API service ---
LEXRAG_API_KEYS=test-key-change-me
LEXRAG_RATE_LIMIT_PER_SEC=2
